# ─────────────────────────────────────────────────────────────────────────────
# hex-staking-pool-sea-creature-tiers — environment template
#
# Copy to `.env` and edit if you want to override a default:
#     cp .env.example .env
# Every value below has a working built-in default, so `.env` is OPTIONAL for a
# standard local run. No API keys are ever required — chain + public RPC only.
# ─────────────────────────────────────────────────────────────────────────────

# ─── RPC endpoints (read-only; public g4mm4 Erigon nodes are the documented defaults) ───
# Ethereum mainnet (chainId 1)
ETH_RPC_URL=https://rpc-ethereum.g4mm4.io
# PulseChain (chainId 369)
PLS_RPC_URL=https://rpc-pulsechain.g4mm4.io
#
# Backup RPCs — used automatically on a transient failure of the primary (the
# client rotates primary -> backup -> primary -> …). These lines are OPTIONAL
# env overrides; the shipped defaults live in config/chains.json. The Ethereum
# backup is best configured as an Ankr endpoint via config/secrets.json (copy
# config/secrets.example.json and add your key) — that keeps the key out of the
# repo. Uncomment below only to override those defaults from the environment:
# ETH_RPC_URL_FALLBACK=https://rpc.ankr.com/eth/YOUR_ANKR_ETH_API_KEY
# PLS_RPC_URL_FALLBACK=https://rpc.pulsechain.box/

# ─── Dashboard server (npm start) ───
# Port for the local dashboard
PORT=3693
# Bind address (localhost-only by default)
HOST=127.0.0.1

# ─── Scan tuning (be a polite client of the public endpoints) ───
# Max concurrent in-flight RPC requests per chain
CONCURRENCY=4
# Starting eth_getLogs block window; auto-halves on "too many results"/size/timeout
# and grows back on success. 5000 matches the g4mm4 per-request block-range cap.
ETH_LOG_CHUNK=5000
PLS_LOG_CHUNK=5000
# Blocks to stay behind chain head when pinning the as-of tip (reorg safety margin)
TIP_LAG_BLOCKS=64

# ─── OA (Origin Address) funding-cluster detection ───
# Maximum hops to search back through the funding tree from a staker's address.
OA_MAX_HOPS=3
# Minimum OA-funded fraction, per asset (HEX or native coin), to classify a wallet
# as part of the OA cluster. 0.20 = 20%.
OA_FUNDING_THRESHOLD=0.20

# ─── Experimental: RPC-response cache ───
# Set to 1 to memoize every getCode / getLogs / trace_filter / eth_call response
# to data/rpc-cache-<chain>.json, so re-runs never repeat an RPC call. Off by
# default — the file can grow large; it is an aid while iterating.
# RPC_CACHE=1
