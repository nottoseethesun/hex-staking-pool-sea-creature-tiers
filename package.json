{
  "name": "hex-staking-pool-sea-creature-tiers",
  "version": "0.0.0-dev",
  "description": "Read-only, self-hosted educational tool that scans HEX stakes on Ethereum and PulseChain via JSON-RPC and reports the sea-creature league breakdown of the staking pool, excluding the Origin-Address (OA) funding cluster.",
  "main": "server.js",
  "bin": {
    "hexleague": "bin/hexleague.js"
  },
  "scripts": {
    "build": "node scripts/build-info.js",
    "prestart": "node scripts/build-info.js",
    "start": "node server.js",
    "dev": "node scripts/build-info.js && node --watch server.js",
    "verify": "node bin/hexleague.js verify",
    "scan": "node bin/hexleague.js scan",
    "resolve": "node bin/hexleague.js resolve",
    "oa": "node bin/hexleague.js oa",
    "report": "node bin/hexleague.js report",
    "update": "node bin/hexleague.js update",
    "stop": "node scripts/stop.js",
    "scan:stop": "node bin/hexleague.js stop",
    "seed": "node bin/hexleague.js seed",
    "whereami": "node bin/hexleague.js whereami",
    "prepare": "husky",
    "prelint": "node scripts/build-info.js",
    "lint": "eslint bin/ src/ test/ scripts/ server.js public/dashboard-*.js eslint-rules/ --max-warnings 0 && stylelint public/*.css && npm run lint:html && markdownlint-cli2 README.md CLAUDE.md \"docs/**/*.md\" && prettier --check \"**/*.json\" && prettier --check \"**/*.{yml,yaml}\" && github-actionlint .github/workflows/*.yml",
    "lint:html": "html-validate public/*.html",
    "lint:fix": "eslint bin/ src/ test/ scripts/ server.js public/dashboard-*.js eslint-rules/ --fix && stylelint public/*.css --fix && npm run lint:html && markdownlint-cli2 --fix README.md CLAUDE.md \"docs/**/*.md\" && prettier --write \"**/*.json\" && prettier --write \"**/*.{yml,yaml}\"",
    "test": "node --test --test-concurrency=8 test/*.test.js test/eslint-rules/*.test.js",
    "test:coverage": "node --test --test-concurrency=8 --experimental-test-coverage test/*.test.js test/eslint-rules/*.test.js",
    "test:watch": "node --test --watch test/*.test.js test/eslint-rules/*.test.js",
    "check": "node scripts/check.js",
    "format": "prettier --write \"bin/**/*.js\" \"src/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\" \"public/dashboard-*.js\" server.js \"eslint-rules/**/*.js\"",
    "format:check": "prettier --check \"bin/**/*.js\" \"src/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\" \"public/dashboard-*.js\" server.js \"eslint-rules/**/*.js\"",
    "audit:deps": "npm audit --audit-level=high",
    "audit:security": "eslint -c eslint-security.config.js bin/ src/ scripts/ server.js --max-warnings 0",
    "audit:secrets": "secretlint \"src/**/*.js\" \"bin/**/*.js\" \"scripts/**/*.js\" \"server.js\" \".env*\" \"*.json\"",
    "knip": "knip",
    "api-doc": "node scripts/api-doc.js",
    "show-api-doc": "node scripts/show-api-doc.js",
    "publish-cache": "node scripts/publish-cache.js",
    "nuke": "rm -rf node_modules package-lock.json && echo 'Nuked node_modules + package-lock.json — run npm install to reinstall'"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@scalar/api-reference": "^1.52.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.4.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.0",
    "github-actionlint": "^1.7.12",
    "globals": "^17.4.0",
    "html-validate": "^10.11.3",
    "husky": "^9.1.7",
    "knip": "^5.86.0",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.23.1",
    "prettier": "^3.8.1",
    "secretlint": "^11.4.1",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "overrides": {
    "adm-zip": "^0.6.0"
  },
  "lint-staged": {
    "*.js": "prettier --write"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "Apache-2.0"
}
